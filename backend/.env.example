# ==========================================
# OpenVisionAI Backend Configuration
# ==========================================

OPENVISIONAI_APP_NAME=OpenVisionAI
OPENVISIONAI_APP_VERSION=1.0.0
OPENVISIONAI_ENV=development
OPENVISIONAI_DEBUG=true

# ==========================================
# Database
# ==========================================

OPENVISIONAI_DB_SERVER=
OPENVISIONAI_DB_NAME=
OPENVISIONAI_DB_USERNAME=
OPENVISIONAI_DB_PASSWORD=
OPENVISIONAI_DB_DRIVER=

# ==========================================
# Authentication
# ==========================================

OPENVISIONAI_SECRET_KEY=
OPENVISIONAI_ALGORITHM=HS256
OPENVISIONAI_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Azure Storage
# ==========================================

OPENVISIONAI_STORAGE_ACCOUNT=
OPENVISIONAI_STORAGE_CONNECTION_STRING=

# ==========================================
# Azure Machine Learning
# ==========================================

OPENVISIONAI_AZURE_TRAINING_CODE_PATH=
OPENVISIONAI_ENVIRONMENT_VERSION=

OPENVISIONAI_AZURE_SUBSCRIPTION_ID=
OPENVISIONAI_AZURE_RESOURCE_GROUP=
OPENVISIONAI_AZURE_ML_WORKSPACE=

OPENVISIONAI_COMPUTE_CLUSTER=
OPENVISIONAI_ENVIRONMENT_NAME=

# ==========================================
# Inference
# ==========================================

OPENVISIONAI_INFERENCE_URL=http://127.0.0.1:5001

# ==========================================
# SQL Configuration
# ==========================================

OPENVISIONAI_SQL_SERVER=
OPENVISIONAI_SQL_DATABASE=
OPENVISIONAI_SQL_USERNAME=
OPENVISIONAI_SQL_PASSWORD=

# ==========================================
# Azure Identity / Service Principal
# ==========================================

OPENVISIONAI_AZURE_TENANT_ID=
OPENVISIONAI_AZURE_CLIENT_ID=
OPENVISIONAI_AZURE_CLIENT_SECRET=

# ==========================================
# Azure Blob Containers
# ==========================================

OPENVISIONAI_DATASET_CONTAINER=
OPENVISIONAI_MODEL_CONTAINER=
OPENVISIONAI_EXPORT_CONTAINER=
OPENVISIONAI_REPORT_CONTAINER=
OPENVISIONAI_ARTIFACT_CONTAINER=

# ==========================================
# Hugging Face
# ==========================================

OPENVISIONAI_HF_TOKEN=
